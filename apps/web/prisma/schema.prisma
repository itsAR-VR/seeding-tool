// Seed Scale — Canonical Prisma Schema
// Based on finalplan.md Section 4: Canonical Data Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Tenancy & Billing
// ──────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?

  supabaseId String? @unique @map("supabase_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationMemberships OrganizationMembership[]
  brandMemberships        BrandMembership[]
  activityLogs            ActivityLog[]

  @@map("users")
}

model Organization {
  id   String @id @default(uuid())
  name String
  slug String @unique

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMembership[]
  clients       Client[]
  subscriptions Subscription[]

  @@map("organizations")
}

model OrganizationMembership {
  id     String @id @default(uuid())
  role   String @default("member") // owner | admin | member

  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

model Client {
  id   String @id @default(uuid())
  name String

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands Brand[]

  @@map("clients")
}

model Brand {
  id         String  @id @default(uuid())
  name       String
  slug       String  @unique
  websiteUrl String? @map("website_url")

  clientId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         BrandMembership[]
  onboarding          BrandOnboarding?
  settings            BrandSettings?
  outreachTemplates   OutreachTemplate[]
  products            BrandProduct[]
  providerCredentials ProviderCredential[]
  connections         BrandConnection[]
  emailAliases        EmailAlias[]
  sendingMetrics      SendingMetric[]
  discoverySeeds      DiscoverySeed[]
  campaigns           Campaign[]
  creators            Creator[]
  conversationThreads ConversationThread[]
  interventionCases   InterventionCase[]
  webhookEvents       WebhookEvent[]
  backgroundJobs      BackgroundJob[]
  activityLogs        ActivityLog[]
  creatorSearchJobs   CreatorSearchJob[]
  aiPersonas          AiPersona[]
  automations         Automation[]
  shopifyProducts     ShopifyProduct[]
  creditBalance       BrandCreditBalance?

  @@map("brands")
}

model BrandMembership {
  id   String @id @default(uuid())
  role String @default("member") // owner | editor | viewer

  userId  String
  brandId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brandId])
  @@map("brand_memberships")
}

model SubscriptionPlan {
  id          String @id @default(uuid())
  name        String // Free | Starter | Growth | Enterprise
  stripePriceId String? @unique @map("stripe_price_id")
  monthlyPrice  Int    @default(0) // cents
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements  SubscriptionEntitlement[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model SubscriptionEntitlement {
  id    String @id @default(uuid())
  key   String // max_brands | max_creators_per_campaign | max_campaigns | etc.
  value String // numeric or boolean as string

  planId String

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
  @@map("subscription_entitlements")
}

model Subscription {
  id     String @id @default(uuid())
  status String @default("active") // active | past_due | canceled | trialing

  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  organizationId String
  planId         String

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// ──────────────────────────────────────────────
// Brand Configuration
// ──────────────────────────────────────────────

model BrandOnboarding {
  id            String  @id @default(uuid())
  currentStep   Int     @default(0)
  completedSteps Json   @default("[]") // JSON array of completed step numbers
  isComplete    Boolean @default(false)

  brandId String @unique

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_onboardings")
}

model BrandSettings {
  id String @id @default(uuid())

  brandVoice          String? // brand voice description for AI
  brandProfile        Json?
  defaultFollowUpDays Int     @default(3)
  maxFollowUps        Int     @default(3)
  reminderWindowDays  Int     @default(14)
  timezone            String  @default("America/New_York")

  metadata            Json?   // feature flags and brand-specific config

  brandId String @unique

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_settings")
}

// ──────────────────────────────────────────────
// Credit System
// ──────────────────────────────────────────────

model BrandCreditBalance {
  id      String @id @default(uuid())
  credits Int    @default(0)

  brandId String @unique

  brand        Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  transactions BrandCreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_credit_balances")
}

model BrandCreditTransaction {
  id        String  @id @default(uuid())
  type      String  // "mint" | "debit"
  amount    Int     // positive for mint, negative for debit
  reason    String?
  metadata  Json?

  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  balanceId String

  balance BrandCreditBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("brand_credit_transactions")
}

model OutreachTemplate {
  id        String @id @default(uuid())
  name      String
  type      String // initial | follow_up_1 | follow_up_2 | follow_up_3 | reminder
  subject   String
  body      String @db.Text
  isDefault Boolean @default(false)

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("outreach_templates")
}

model BrandProduct {
  id          String @id @default(uuid())
  name        String
  description String?
  productUrl  String?

  shopifyProductId  String? @map("shopify_product_id")
  shopifyVariantId  String? @map("shopify_variant_id")
  retailValue       Int?    // cents

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignProducts CampaignProduct[]

  @@map("brand_products")
}

model ProviderCredential {
  id       String @id @default(uuid())
  provider String // shopify | gmail | instagram | unipile | google_ads | meta_ads | amazon_seller_central | google_sheets
  label    String?
  credentialType String @default("api_key") // oauth_refresh_token | oauth_access_token | api_key | shopify_admin_token

  encryptedValue String @db.Text @map("encrypted_value") // AES-256-GCM encrypted
  expiresAt      DateTime?
  isValid        Boolean @default(true)

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, provider])
  @@map("provider_credentials")
}

model BrandConnection {
  id       String @id @default(uuid())
  provider String // shopify | gmail | instagram | unipile | google_ads | meta_ads | amazon_seller_central | google_sheets
  status   String @default("connected") // connected | disconnected | error
  connectionMethod String @default("manual") // oauth | manual

  externalId  String? // e.g. Shopify store domain, Gmail address
  metadata    Json?   // provider-specific data

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, provider])
  @@map("brand_connections")
}

model EmailAlias {
  id          String @id @default(uuid())
  address     String
  displayName String?
  isPrimary   Boolean @default(false)
  isWarmedUp  Boolean @default(false)
  isPaused    Boolean @default(false)
  dailyLimit  Int     @default(50)

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sendingMetrics SendingMetric[]

  @@unique([brandId, address])
  @@map("email_aliases")
}

model SendingMetric {
  id   String @id @default(uuid())
  date DateTime @db.Date

  sent      Int @default(0)
  bounced   Int @default(0)
  complained Int @default(0)

  aliasId String
  brandId String

  alias EmailAlias @relation(fields: [aliasId], references: [id], onDelete: Cascade)
  brand Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aliasId, date])
  @@map("sending_metrics")
}

model EmailSuppression {
  id           String   @id @default(uuid())
  email        String   @unique
  reason       String   // UNSUBSCRIBE | BOUNCE | COMPLAINT | MANUAL
  suppressedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@map("email_suppressions")
}

model DiscoverySeed {
  id       String @id @default(uuid())
  platform String // instagram | tiktok
  handle   String
  note     String?

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, platform, handle])
  @@map("discovery_seeds")
}

// ──────────────────────────────────────────────
// Campaign & Creator Backbone
// ──────────────────────────────────────────────

model Campaign {
  id          String @id @default(uuid())
  name        String
  description String?
  status      String @default("draft") // draft | active | paused | completed | archived
  portfolioConfig Json? @map("portfolio_config")

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignProducts  CampaignProduct[]
  campaignCreators  CampaignCreator[]
  creatorSearchJobs CreatorSearchJob[]
  outcomes          CampaignOutcome[]

  @@map("campaigns")
}

model CampaignProduct {
  id String @id @default(uuid())

  campaignId       String
  productId        String
  shopifyProductId String?
  shopifyVariantId String?
  note             String?

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product        BrandProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyProduct ShopifyProduct? @relation(fields: [shopifyProductId], references: [id])
  shopifyVariant ShopifyVariant? @relation(fields: [shopifyVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

model Creator {
  id String @id @default(uuid())

  name     String?
  email    String?
  phone    String?
  imageUrl String?
  bio      String? @db.Text
  notes    String? @db.Text

  instagramHandle String? @map("instagram_handle")

  /// Source of discovery: phantombuster | apify | csv_import | manual | creator_marketplace
  // INVARIANT: discoverySource is always tagged — never null
  discoverySource String @default("manual") @map("discovery_source")

  followerCount Int?    @map("follower_count")
  avgViews      Int?    @map("avg_views")
  bioCategory   String? @map("bio_category")
  validationStatus   String    @default("unknown") @map("validation_status")
  validationErrorCode String?  @map("validation_error_code")
  validationAttempts  Int      @default(0) @map("validation_attempts")
  lastValidatedAt    DateTime? @map("last_validated_at")
  lastValidationError String?  @db.Text @map("last_validation_error")
  influencerIdentityId String? @map("influencer_identity_id")

  optedOut   Boolean   @default(false)
  optOutDate DateTime?

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  influencerIdentity InfluencerIdentity? @relation(fields: [influencerIdentityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles          CreatorProfile[]
  campaignCreators  CampaignCreator[]
  discoveryTouches  CreatorDiscoveryTouch[]
  rawPayloads       CreatorRawPayload[]
  outcomes          CampaignOutcome[]

  @@unique([brandId, instagramHandle])
  @@index([influencerIdentityId])
  @@map("creators")
}

model CreatorProfile {
  id       String @id @default(uuid())
  platform String // instagram | tiktok | youtube | twitter
  handle   String
  url      String?

  followerCount   Int?
  engagementRate  Float?
  isVerified      Boolean @default(false)
  metadata        Json?   // platform-specific stats

  creatorId String

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform])
  @@map("creator_profiles")
}

model InfluencerIdentity {
  id              String   @id @default(uuid())
  displayName     String?  @map("display_name")
  primaryLanguage String?  @map("primary_language")
  homeRegion      String?  @map("home_region")
  mergedIntoId    String?  @map("merged_into_id")

  mergedInto  InfluencerIdentity?  @relation("InfluencerIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom  InfluencerIdentity[] @relation("InfluencerIdentityMerge")
  creators    Creator[]
  profiles    InfluencerPlatformProfile[]
  outcomes    CampaignOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mergedIntoId])
  @@map("influencer_identities")
}

model InfluencerPlatformProfile {
  id               String   @id @default(uuid())
  influencerId     String   @map("influencer_id")
  platform         String
  platformUserId   String?  @map("platform_user_id")
  handle           String
  normalizedHandle String   @map("normalized_handle")
  profileUrl       String?  @map("profile_url")
  profileImageUrl  String?  @map("profile_image_url")
  websiteUrl       String?  @map("website_url")
  bioText          String?  @db.Text @map("bio_text")
  email            String?
  region           String?
  languageDetected String?  @map("language_detected")
  isPrivate        Boolean  @default(false) @map("is_private")
  isVerified       Boolean  @default(false) @map("is_verified")
  followerCount    Int?     @map("follower_count")
  followingCount   Int?     @map("following_count")
  postCount        Int?     @map("post_count")
  avgViews         Int?     @map("avg_views")
  engagementRate   Float?   @map("engagement_rate")
  metadata         Json?
  lastFetchedAt    DateTime? @map("last_fetched_at")

  influencer             InfluencerIdentity               @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  edgesFrom              IdentityEdge[]                   @relation("IdentityEdgeFrom")
  edgesTo                IdentityEdge[]                   @relation("IdentityEdgeTo")
  contactPoints          ContactPoint[]
  metricsDaily           InfluencerMetricsDaily[]
  authenticityAssessments InfluencerAuthenticityAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, normalizedHandle])
  @@index([influencerId])
  @@index([platform, platformUserId])
  @@map("influencer_platform_profiles")
}

model IdentityEdge {
  id            String   @id @default(uuid())
  fromProfileId String   @map("from_profile_id")
  toProfileId   String   @map("to_profile_id")
  matchScore    Float    @map("match_score")
  matchBand     String   @map("match_band")
  evidenceJson  Json     @map("evidence_json")
  reviewedBy    String?  @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewOutcome String?  @map("review_outcome")

  fromProfile InfluencerPlatformProfile @relation("IdentityEdgeFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   InfluencerPlatformProfile @relation("IdentityEdgeTo", fields: [toProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromProfileId, toProfileId])
  @@index([matchBand])
  @@index([reviewOutcome])
  @@map("identity_edges")
}

model ContactPoint {
  id             String   @id @default(uuid())
  profileId       String   @map("profile_id")
  contactType     String   @map("contact_type")
  contactValue    String   @map("contact_value")
  confidence      Float
  source          String
  isStale         Boolean  @default(false) @map("is_stale")
  lastVerifiedAt  DateTime? @map("last_verified_at")
  metadata        Json?

  profile InfluencerPlatformProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([contactType, confidence])
  @@map("contact_points")
}

/// CampaignCreator replaces the Airtable People table.
/// Uses TWO status fields: reviewStatus (approval) + lifecycleStatus (execution).
model CampaignCreator {
  id String @id @default(uuid())

  /// Human approval gate: pending | approved | declined | deferred
  reviewStatus    String @default("pending") @map("review_status")

  /// Post-approval execution: ready | outreach_sent | replied | address_confirmed |
  /// order_created | shipped | delivered | posted | completed | opted_out | stalled
  lifecycleStatus String @default("ready") @map("lifecycle_status")

  reviewedAt   DateTime?
  reviewedBy   String?
  declineReason String?

  outreachCount  Int @default(0)
  lastOutreachAt DateTime?
  lastReplyAt    DateTime?

  campaignId String
  creatorId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversationThread     ConversationThread?
  shippingSnapshots      ShippingAddressSnapshot[]
  shopifyOrder           ShopifyOrder?
  costRecords            CostRecord[]
  mentionAssets          MentionAsset[]
  reminderSchedules      ReminderSchedule[]
  aiDrafts               AIDraft[]
  outcome                CampaignOutcome?

  @@unique([campaignId, creatorId])
  @@map("campaign_creators")
}

model CreatorSearchJob {
  id     String @id @default(uuid())
  status String @default("pending") // pending | running | completed | failed | paused
  requestedCount Int @default(0) @map("requested_count")
  candidateCount Int @default(0) @map("candidate_count")
  validatedCount Int @default(0) @map("validated_count")
  invalidCount   Int @default(0) @map("invalid_count")
  cachedCount    Int @default(0) @map("cached_count")
  progressPercent Int @default(0) @map("progress_percent")
  etaSeconds     Int? @map("eta_seconds")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  platform   String // instagram | meta_creator_marketplace
  query      Json   // search parameters
  campaignId String? @map("campaign_id")
  resultCount Int   @default(0)
  error       String?

  brandId String

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results          CreatorSearchResult[]
  discoveryTouches CreatorDiscoveryTouch[]
  rawPayloads      CreatorRawPayload[]

  @@index([brandId, status])
  @@index([campaignId, status])
  @@map("creator_search_jobs")
}

model CreatorSearchResult {
  id String @id @default(uuid())

  platform       String
  handle         String
  source         String @default("unknown")
  primarySource  String? @map("primary_source")
  sources        Json?
  name           String?
  followerCount  Int?
  engagementRate Float?
  profileUrl     String?
  imageUrl       String?
  bio            String? @db.Text
  email          String?
  bioCategory    String? @map("bio_category")
  rawSourceCategory String? @map("raw_source_category")
  seedCreatorId  String? @map("seed_creator_id")
  metadata       Json?
  validationStatus String @default("unknown") @map("validation_status")
  validationError  String? @db.Text @map("validation_error")
  validatedFollowerCount Int? @map("validated_follower_count")
  validatedAvgViews      Int? @map("validated_avg_views")

  fitScore    Float? // AI-scored creator fit (0-1)
  fitReasoning String? @db.Text
  scoreComponents Json? @map("score_components")
  triage         String?
  sourceConfidence Float? @map("source_confidence")
  sourceConfidenceTier String? @map("source_confidence_tier")

  searchJobId String

  searchJob CreatorSearchJob @relation(fields: [searchJobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([searchJobId, source])
  @@map("creator_search_results")
}

model CreatorDiscoveryTouch {
  id String @id @default(uuid())

  source            String
  externalId        String? @map("external_id")
  rawSourceCategory String? @map("raw_source_category")
  canonicalCategory String? @map("canonical_category")
  email             String?
  metadata          Json?
  seedCreatorId     String? @map("seed_creator_id")

  creatorId   String @map("creator_id")
  searchJobId String? @map("search_job_id")

  creator   Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  searchJob CreatorSearchJob? @relation(fields: [searchJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, source])
  @@index([searchJobId])
  @@map("creator_discovery_touches")
}

model CreatorRawPayload {
  id          String   @id @default(uuid())
  creatorId   String?  @map("creator_id")
  searchJobId String?  @map("search_job_id")
  source      String
  eventType   String   @map("event_type")
  payload     Json
  payloadHash String?  @map("payload_hash")

  creator   Creator?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  searchJob CreatorSearchJob? @relation(fields: [searchJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([searchJobId])
  @@index([source, createdAt])
  @@map("creator_raw_payloads")
}

model InfluencerMetricsDaily {
  id               String   @id @default(uuid())
  profileId        String   @map("profile_id")
  date             DateTime @db.Date
  followers        Int?
  following        Int?
  posts            Int?
  avgViews         Int?     @map("avg_views")
  engagementRate   Float?   @map("engagement_rate")
  likes            Int?
  comments         Int?
  source           String
  sourceConfidence Float    @default(0) @map("source_confidence")

  profile InfluencerPlatformProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, date])
  @@index([profileId, date])
  @@index([date])
  @@map("influencer_metrics_daily")
}

model InfluencerAuthenticityAssessment {
  id                     String   @id @default(uuid())
  profileId              String   @map("profile_id")
  authScore              Float    @map("auth_score")
  botRiskScore           Float    @map("bot_risk_score")
  growthAnomalyScore     Float    @map("growth_anomaly_score")
  engagementQualityScore Float    @map("engagement_quality_score")
  modelVersion           String   @map("model_version")
  notesJson              Json?    @map("notes_json")
  inputSnapshotCount     Int      @default(0) @map("input_snapshot_count")

  profile InfluencerPlatformProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now()) @map("computed_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId, computedAt])
  @@index([authScore])
  @@map("influencer_authenticity_assessments")
}

model CampaignOutcome {
  id                  String   @id @default(uuid())
  campaignCreatorId   String   @unique @map("campaign_creator_id")
  campaignId          String   @map("campaign_id")
  creatorId           String   @map("creator_id")
  identityId          String?  @map("identity_id")
  reviewDecision      String?  @map("review_decision")
  reviewedAt          DateTime? @map("reviewed_at")
  reviewedBy          String?  @map("reviewed_by")
  declineReason       String?  @db.Text @map("decline_reason")
  outreachSentAt      DateTime? @map("outreach_sent_at")
  outreachMethod      String?  @map("outreach_method")
  repliedAt           DateTime? @map("replied_at")
  replyType           String?  @map("reply_type")
  responseTimeHours   Float?   @map("response_time_hours")
  acceptedAt          DateTime? @map("accepted_at")
  addressConfirmedAt  DateTime? @map("address_confirmed_at")
  orderCreatedAt      DateTime? @map("order_created_at")
  shippedAt           DateTime? @map("shipped_at")
  deliveredAt         DateTime? @map("delivered_at")
  postedAt            DateTime? @map("posted_at")
  completedAt         DateTime? @map("completed_at")
  optedOutAt          DateTime? @map("opted_out_at")
  stalledAt           DateTime? @map("stalled_at")
  stallReason         String?  @db.Text @map("stall_reason")
  contentQuality      String?  @map("content_quality")
  contentReach        Int?     @map("content_reach")
  contentEngagement   Float?   @map("content_engagement")
  costPerCreator      Float?   @map("cost_per_creator")
  costPerEngagement   Float?   @map("cost_per_engagement")
  fitScoreAtSeed      Float?   @map("fit_score_at_seed")
  triageAtSeed        String?  @map("triage_at_seed")
  scoreComponentsAtSeed Json?  @map("score_components_at_seed")

  campaignCreator CampaignCreator      @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  campaign       Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator        Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  identity       InfluencerIdentity?   @relation(fields: [identityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
  @@index([identityId])
  @@index([reviewDecision])
  @@map("campaign_outcomes")
}

// ──────────────────────────────────────────────
// Inbox & Operations
// ──────────────────────────────────────────────

model ConversationThread {
  id      String @id @default(uuid())
  subject String?
  status  String @default("open") // open | closed | snoozed
  channel String @default("email") // email | instagram_dm

  externalThreadId String? @unique @map("external_thread_id") // Gmail thread ID
  unipileChatId    String? @map("unipile_chat_id") // Unipile chat ID for DM routing

  campaignCreatorId String @unique @map("campaign_creator_id")
  brandId           String

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    Message[]
  aiArtifacts AIArtifact[]

  @@map("conversation_threads")
}

model Message {
  id        String @id @default(uuid())
  direction String // inbound | outbound
  channel   String @default("email") // email | manual | instagram_dm

  fromAddress String?
  toAddress   String?
  subject     String?
  body        String  @db.Text
  bodyHtml    String? @db.Text @map("body_html")

  externalMessageId String? @unique @map("external_message_id") // Gmail message ID

  classification String? // interested | address_provided | question | decline | opt_out | unclear | commercial
  confidence     Float?

  threadId String

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

model AIArtifact {
  id   String @id @default(uuid())
  type String // classification | extraction | fit_score | draft | summary

  input  Json?
  output Json?
  model  String? // e.g. gpt-4o
  tokens Int?

  threadId String?

  thread ConversationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_artifacts")
}

model AIDraft {
  id      String @id @default(uuid())
  type    String // reply | outreach | follow_up | reminder
  status  String @default("draft") // draft | approved | sent | discarded

  subject String?
  body    String  @db.Text

  approvedAt DateTime?
  approvedBy String?

  campaignCreatorId String @map("campaign_creator_id")

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_drafts")
}

model ShippingAddressSnapshot {
  id String @id @default(uuid())

  fullName    String?
  line1       String?
  line2       String?
  city        String?
  state       String?
  postalCode  String?  @map("postal_code")
  country     String?
  phone       String?

  source     String @default("ai_extracted") // ai_extracted | manual | creator_provided
  isActive   Boolean @default(false)
  isLocked   Boolean @default(false)
  confirmedAt DateTime?
  confirmedBy String?

  campaignCreatorId String @map("campaign_creator_id")

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_address_snapshots")
}

model ShopifyOrder {
  id String @id @default(uuid())

  shopifyOrderId     String  @unique @map("shopify_order_id")
  shopifyOrderNumber String? @map("shopify_order_number")
  status             String  @default("created") // created | processing | shipped | delivered | cancelled

  totalPrice Int? // cents
  currency   String @default("USD")

  campaignCreatorId String @unique @map("campaign_creator_id")

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentEvents FulfillmentEvent[]

  @@map("shopify_orders")
}

model FulfillmentEvent {
  id     String @id @default(uuid())
  status String // confirmed | in_transit | out_for_delivery | delivered | failure | cancelled

  trackingNumber  String? @map("tracking_number")
  trackingUrl     String? @map("tracking_url")
  carrier         String?
  estimatedDelivery DateTime? @map("estimated_delivery")

  externalEventId String? @unique @map("external_event_id")

  orderId String

  order ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fulfillment_events")
}

model CostRecord {
  id       String @id @default(uuid())
  type     String // product | shipping | platform_fee | other
  amount   Int    // cents
  currency String @default("USD")
  note     String?

  campaignCreatorId String @map("campaign_creator_id")

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cost_records")
}

model MentionAsset {
  id       String @id @default(uuid())
  platform String // instagram | tiktok | youtube | twitter
  mediaUrl String @map("media_url")
  type     String? // post | story | reel | video

  caption  String? @db.Text
  likes    Int?
  comments Int?
  views    Int?
  postedAt DateTime? @map("posted_at")

  campaignCreatorId String @map("campaign_creator_id")

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Dedupe by platform + mediaUrl
  @@unique([platform, mediaUrl])
  @@map("mention_assets")
}

model ReminderSchedule {
  id     String @id @default(uuid())
  type   String // post_reminder | follow_up_reminder
  status String @default("pending") // pending | sent | cancelled | suppressed

  scheduledFor DateTime @map("scheduled_for")
  sentAt       DateTime?
  cancelReason String?

  campaignCreatorId String @map("campaign_creator_id")

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reminder_schedules")
}

model InterventionCase {
  id       String @id @default(uuid())
  type     String // captcha | auth_failure | duplicate_order | unclear_reply | manual_review | other
  status   String @default("open") // open | in_progress | resolved | reopened
  priority String @default("normal") // low | normal | high | critical

  title       String
  description String? @db.Text
  resolution  String? @db.Text

  assigneeId String?
  resolvedAt DateTime?
  resolvedBy String?

  brandId            String
  campaignCreatorId  String? @map("campaign_creator_id")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("intervention_cases")
}

model WebhookEvent {
  id       String @id @default(uuid())
  provider String // stripe | shopify | gmail | instagram
  eventType String @map("event_type")

  externalEventId String? @unique @map("external_event_id")
  payload         Json
  status          String @default("pending") // pending | processing | processed | failed
  error           String?
  attempts        Int    @default(0)
  processedAt     DateTime?

  brandId String?

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, status])
  @@map("webhook_events")
}

model BackgroundJob {
  id        String @id @default(uuid())
  type      String // outreach | follow_up | reply_process | order_create | fulfillment_sync | reminder_send | mention_process | search_dispatch | billing_sync | alias_warmup | health_check
  status    String @default("pending") // pending | running | completed | failed | cancelled

  dedupeKey String? @unique @map("dedupe_key")
  payload   Json?
  result    Json?
  error     String?
  attempts  Int    @default(0)
  maxAttempts Int  @default(3) @map("max_attempts")

  scheduledFor DateTime? @map("scheduled_for")
  startedAt    DateTime?
  completedAt  DateTime?

  brandId String?

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([scheduledFor])
  @@map("background_jobs")
}

model ActivityLog {
  id     String @id @default(uuid())
  action String // e.g. creator.approved, outreach.sent, order.created, etc.

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?

  userId  String?
  brandId String

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([brandId, action])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ──────────────────────────────────────────────
// AI Personas
// ──────────────────────────────────────────────

model AiPersona {
  id          String  @id @default(uuid())
  name        String
  description String?
  tone        String  // professional | casual | influencer
  systemPrompt String @db.Text @map("system_prompt")
  exampleMessages Json? @map("example_messages") // array of example messages

  brandId   String
  isDefault Boolean @default(false)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_personas")
}

// ──────────────────────────────────────────────
// Automations
// ──────────────────────────────────────────────

model Automation {
  id       String  @id @default(uuid())
  name     String
  type     String  // creator_discovery | mention_check | etc.
  schedule String  // cron expression or preset (e.g. "daily", "every_12h", "every_6h", "weekly")
  config   Json    // type-specific configuration
  enabled  Boolean @default(true)

  lastRunAt DateTime?
  nextRunAt DateTime?

  brandId String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automations")
}

// ──────────────────────────────────────────────
// Shopify Product Catalog
// ──────────────────────────────────────────────

model ShopifyProduct {
  id          String  @id @default(uuid())
  shopifyId   String
  title       String
  description String? @db.Text
  handle      String?
  productType String?
  imageUrl    String?
  status      String  @default("active") // active | draft | archived

  variants ShopifyVariant[]

  brandId String
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  campaignProducts CampaignProduct[]

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, shopifyId])
  @@map("shopify_products")
}

model ShopifyVariant {
  id               String  @id @default(uuid())
  shopifyVariantId String
  title            String
  price            String
  sku              String?
  inventoryQuantity Int?
  imageUrl         String?

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  campaignProducts CampaignProduct[]

  @@unique([productId, shopifyVariantId])
  @@map("shopify_variants")
}
